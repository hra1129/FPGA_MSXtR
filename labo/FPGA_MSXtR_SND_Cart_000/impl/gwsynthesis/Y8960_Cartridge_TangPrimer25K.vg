    .I0(ff_enable),
    .I1(cyccntr[0]) 
);
defparam n15_s4.INIT=4'h9;
  DFFSE cntr_3_s0 (
    .Q(cyccntr[3]),
    .D(n12_6),
    .CLK(clk_42m),
    .SET(n326_7),
    .CE(cenop_31) 
);
  DFFSE cntr_2_s1 (
    .Q(cyccntr[2]),
    .D(n13_9),
    .CLK(clk_42m),
    .SET(n326_7),
    .CE(VCC) 
);
