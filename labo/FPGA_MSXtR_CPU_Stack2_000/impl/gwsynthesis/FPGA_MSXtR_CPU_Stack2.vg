module pause_led (
  clk42m,
  w_msx_pause,
  w_r800_performance_stop_7,
  n491_5,
  n683_5,
  w_r800_bus_address_2_3,
  w_slot_address_2_7,
  w_slot_address_2_5,
  n3720_5,
  n75_12,
  ff_pause_led_reset_n,
  w_slot_d,
  w_slot_address,
  w_r800_led,
  w_device_pause_led_rdata_en,
  n7_4,
  n7_5,
  w_device_pause_led_rdata
)
;
input clk42m;
input w_msx_pause;
input w_r800_performance_stop_7;
input n491_5;
input n683_5;
input w_r800_bus_address_2_3;
input w_slot_address_2_7;
input w_slot_address_2_5;
input n3720_5;
input n75_12;
input ff_pause_led_reset_n;
input [0:0] w_slot_d;
input [4:3] w_slot_address;
output w_r800_led;
output w_device_pause_led_rdata_en;
output n7_4;
output n7_5;
output [0:0] w_device_pause_led_rdata;
wire n7_3;
wire n18_6;
wire n11_5;
wire VCC;
wire GND;
  LUT4 n7_s0 (
    .F(n7_3),
    .I0(n7_4),
    .I1(w_r800_performance_stop_7),
    .I2(n7_5),
    .I3(n491_5) 
);
defparam n7_s0.INIT=16'h0080;
  LUT2 n7_s1 (
    .F(n7_4),
    .I0(n683_5),
    .I1(w_slot_address[4]) 
);
defparam n7_s1.INIT=4'h2;
  LUT4 n7_s2 (
    .F(n7_5),
    .I0(w_slot_address[3]),
    .I1(w_r800_bus_address_2_3),
    .I2(w_slot_address_2_7),
    .I3(w_slot_address_2_5) 
);
defparam n7_s2.INIT=16'h4500;
  LUT4 n18_s2 (
    .F(n18_6),
    .I0(n683_5),
    .I1(w_slot_address[4]),
    .I2(n3720_5),
    .I3(n75_12) 
);
defparam n18_s2.INIT=16'h2000;
  DFFRE ff_r800_led_s0 (
    .Q(w_r800_led),
    .D(w_slot_d[0]),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(n7_3) 
);
  DFFRE ff_rdata_0_s0 (
    .Q(w_device_pause_led_rdata[0]),
    .D(w_msx_pause),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(n18_6) 
);
  DFFRE ff_rdata_en_s0 (
    .Q(w_device_pause_led_rdata_en),
    .D(n18_6),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(VCC) 
);
defparam ff_rdata_en_s0.INIT=1'b0;
  INV n11_s2 (
    .O(n11_5),
    .I(ff_pause_led_reset_n) 
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* pause_led */
