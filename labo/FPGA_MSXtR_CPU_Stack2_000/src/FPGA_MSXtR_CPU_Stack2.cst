// FPGA_MSXtR CPU Stack2 - pin constraints
// TangPrimer25K (GW5A-LV25MG121NC1/I0)
// Pin assignment: pins_stack2.txt (TangPrimer25K(CPU))
// flash_spi_* (config flash dedicated pins) and clk_50m are carried over
// from the CPU Stack design.

// ---- clocks / uart (same as CPU Stack) ----
IO_LOC "clk_50m" E2;
IO_PORT "clk_50m" IO_TYPE=LVTTL33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "clk_28m" H5;
IO_PORT "clk_28m" IO_TYPE=LVTTL33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "uart_tx" C3;
IO_PORT "uart_tx" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_rx" B3;
IO_PORT "uart_rx" IO_TYPE=LVTTL33 PULL_MODE=NONE BANK_VCCIO=3.3;

// ---- config flash (dedicated pins, carried over) ----
IO_LOC "flash_spi_cs_n" E6;
IO_PORT "flash_spi_cs_n" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "flash_spi_clk" E7;
IO_PORT "flash_spi_clk" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "flash_spi_io[3]" E4;
IO_PORT "flash_spi_io[3]" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "flash_spi_io[2]" D5;
IO_PORT "flash_spi_io[2]" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "flash_spi_io[1]" E5;
IO_PORT "flash_spi_io[1]" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "flash_spi_io[0]" D6;
IO_PORT "flash_spi_io[0]" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- serial SRAM (VTI7064, single chip) ----
IO_LOC "sram_ce_n" C2;
IO_PORT "sram_ce_n" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sram_sclk" F2;
IO_PORT "sram_sclk" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sram_sio[3]" B2;
IO_PORT "sram_sio[3]" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sram_sio[2]" E1;
IO_PORT "sram_sio[2]" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sram_sio[1]" A1;
IO_PORT "sram_sio[1]" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sram_sio[0]" F1;
IO_PORT "sram_sio[0]" IO_TYPE=LVTTL33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

