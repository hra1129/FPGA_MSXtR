module ip_ram (
  clk42m,
  w_ram_cs,
  w_re,
  n24_6,
  w_we,
  w_device_address,
  w_device_wdata,
  w_ram_q
)
;
input clk42m;
input w_ram_cs;
input w_re;
input n24_6;
input w_we;
input [10:0] w_device_address;
input [7:0] w_device_wdata;
output [7:0] w_ram_q;
wire [31:8] DO;
wire VCC;
wire GND;
  SP u_ram_s31 (
    .DO({DO[31:8],w_ram_q[7:0]}),
    .CLK(clk42m),
    .CE(w_ram_cs),
    .OCE(w_re),
    .RESET(n24_6),
    .WRE(w_we),
    .AD({w_device_address[10:0],GND,GND,GND}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,w_device_wdata[7:0]}),
    .BLKSEL({GND,GND,GND}) 
);
defparam u_ram_s31.BIT_WIDTH=8;
defparam u_ram_s31.BLK_SEL=3'b000;
defparam u_ram_s31.READ_MODE=1'b1;
defparam u_ram_s31.RESET_MODE="SYNC";
defparam u_ram_s31.WRITE_MODE=2'b00;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* ip_ram */
module bootrom (
  clk42m,
  w_device_write,
  w_device_bootrom_cs,
  w_device_valid,
  ff_bootrom_reset_n,
  n337_5,
  n589_5,
  n331_5,
  w_device_address,
  w_device_wdata,
  w_device_bootrom_rdata_en,
  ff_is_ram,
  w_ram_q,
  w_rom_q
)
;
input clk42m;
input w_device_write;
input w_device_bootrom_cs;
input w_device_valid;
input ff_bootrom_reset_n;
input n337_5;
input n589_5;
input n331_5;
input [12:0] w_device_address;
input [7:0] w_device_wdata;
output w_device_bootrom_rdata_en;
output ff_is_ram;
output [7:0] w_ram_q;
output [7:0] w_rom_q;
wire n34_3;
wire w_we;
wire w_re;
wire w_ram_cs;
wire n24_6;
wire w_ram_cs_10;
wire VCC;
wire GND;
  LUT2 n34_s0 (
    .F(n34_3),
    .I0(w_device_valid),
    .I1(w_device_bootrom_cs) 
);
defparam n34_s0.INIT=4'h8;
  LUT3 w_we_s1 (
    .F(w_we),
    .I0(w_device_write),
    .I1(w_device_address[12]),
    .I2(w_device_valid) 
);
defparam w_we_s1.INIT=8'h80;
  LUT3 w_re_s1 (
    .F(w_re),
    .I0(w_device_write),
    .I1(w_device_address[12]),
    .I2(w_device_valid) 
);
defparam w_re_s1.INIT=8'h40;
  LUT2 w_ram_cs_s3 (
    .F(w_ram_cs),
    .I0(w_device_address[12]),
    .I1(w_device_bootrom_cs) 
);
defparam w_ram_cs_s3.INIT=4'h8;
  DFFRE ff_q_en_s0 (
    .Q(w_device_bootrom_rdata_en),
    .D(n34_3),
    .CLK(clk42m),
    .RESET(w_device_write),
    .CE(VCC) 
);
defparam ff_q_en_s0.INIT=1'b0;
  DFFRE ff_is_ram_s0 (
    .Q(ff_is_ram),
    .D(w_device_bootrom_cs),
    .CLK(clk42m),
    .RESET(w_ram_cs_10),
    .CE(VCC) 
);
defparam ff_is_ram_s0.INIT=1'b0;
  INV n24_s2 (
    .O(n24_6),
    .I(ff_bootrom_reset_n) 
);
  INV w_ram_cs_s4 (
    .O(w_ram_cs_10),
    .I(w_device_address[12]) 
);
  rom u_rom (
    .clk42m(clk42m),
    .w_device_write(w_device_write),
    .ff_bootrom_reset_n(ff_bootrom_reset_n),
    .n34_3(n34_3),
    .n337_5(n337_5),
    .n589_5(n589_5),
    .n331_5(n331_5),
    .w_device_address(w_device_address[12:0]),
    .w_rom_q(w_rom_q[7:0])
);
  ip_ram u_ram (
    .clk42m(clk42m),
    .w_ram_cs(w_ram_cs),
    .w_re(w_re),
    .n24_6(n24_6),
    .w_we(w_we),
    .w_device_address(w_device_address[10:0]),
    .w_device_wdata(w_device_wdata[7:0]),
    .w_ram_q(w_ram_q[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* bootrom */
