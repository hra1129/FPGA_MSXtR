module system_flag (
  clk42m,
  w_device_write,
  w_device_valid,
  n110_5,
  n378_6,
  ff_system_flag_reset_n,
  w_device_wdata,
  w_device_address,
  w_device_system_flag_rdata_en,
  n108_8,
  w_device_system_flag_rdata
)
;
input clk42m;
input w_device_write;
input w_device_valid;
input n110_5;
input n378_6;
input ff_system_flag_reset_n;
input [7:0] w_device_wdata;
input [4:0] w_device_address;
output w_device_system_flag_rdata_en;
output n108_8;
output [7:0] w_device_system_flag_rdata;
