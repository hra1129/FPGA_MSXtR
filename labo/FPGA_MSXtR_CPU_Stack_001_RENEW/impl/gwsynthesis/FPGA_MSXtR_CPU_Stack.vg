    .O(n24_6),
    .I(ff_bootrom_reset_n) 
);
  rom u_rom (
    .clk42m(clk42m),
    .w_ram_cs_14(w_ram_cs_14),
    .w_device_bootrom_cs(w_device_bootrom_cs),
    .ff_bootrom_reset_n(ff_bootrom_reset_n),
    .n75_10(n75_10),
    .w_slot_address(w_slot_address[11:0]),
    .w_rom_q(w_rom_q[7:0])
);
  ip_ram u_ram (
    .clk42m(clk42m),
    .w_ram_cs(w_ram_cs),
    .w_re(w_re),
    .n24_6(n24_6),
    .w_we(w_we),
    .w_slot_address(w_slot_address[10:0]),
    .w_device_wdata(w_device_wdata[7:0]),
    .w_ram_q(w_ram_q[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* bootrom */
