module ip_ram (
  clk42m,
  w_ram_cs,
  w_re,
  n24_6,
  w_we,
  w_slot_address,
  w_slot_d,
  w_ram_q
)
;
input clk42m;
input w_ram_cs;
input w_re;
input n24_6;
input w_we;
input [10:0] w_slot_address;
input [7:0] w_slot_d;
output [7:0] w_ram_q;
wire [31:8] DO;
wire VCC;
wire GND;
  SP u_ram_s31 (
    .DO({DO[31:8],w_ram_q[7:0]}),
    .CLK(clk42m),
    .CE(w_ram_cs),
    .OCE(w_re),
    .RESET(n24_6),
    .WRE(w_we),
    .AD({w_slot_address[10:0],GND,GND,GND}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,w_slot_d[7:0]}),
    .BLKSEL({GND,GND,GND}) 
);
defparam u_ram_s31.BIT_WIDTH=8;
defparam u_ram_s31.BLK_SEL=3'b000;
defparam u_ram_s31.READ_MODE=1'b1;
defparam u_ram_s31.RESET_MODE="SYNC";
defparam u_ram_s31.WRITE_MODE=2'b00;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* ip_ram */
