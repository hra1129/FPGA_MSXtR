module pause_led (
  clk42m,
  w_msx_pause,
  n75_9,
  w_r800_performance_stop_7,
  w_r800_performance_start_9,
  w_bus_write_5,
  ff_bus_rdata_en_6,
  n233_8,
  ff_pause_led_reset_n,
  w_slot_d,
  w_slot_address_0,
  w_slot_address_2,
  w_slot_address_4,
  w_slot_address_5,
  w_slot_address_6,
  w_r800_led,
  w_device_pause_led_rdata_en,
  n7_4,
  w_device_pause_led_rdata
)
;
input clk42m;
input w_msx_pause;
input n75_9;
input w_r800_performance_stop_7;
input w_r800_performance_start_9;
input w_bus_write_5;
input ff_bus_rdata_en_6;
input n233_8;
input ff_pause_led_reset_n;
input [0:0] w_slot_d;
input w_slot_address_0;
input w_slot_address_2;
input w_slot_address_4;
input w_slot_address_5;
input w_slot_address_6;
output w_r800_led;
output w_device_pause_led_rdata_en;
output n7_4;
output [0:0] w_device_pause_led_rdata;
wire n18_4;
wire n7_5;
wire n7_7;
wire n11_5;
wire VCC;
wire GND;
  LUT2 n18_s1 (
    .F(n18_4),
    .I0(n7_4),
    .I1(n75_9) 
);
defparam n18_s1.INIT=4'h8;
  LUT4 n7_s1 (
    .F(n7_4),
    .I0(w_slot_address_2),
    .I1(w_slot_address_0),
    .I2(w_r800_performance_stop_7),
    .I3(n7_5) 
);
defparam n7_s1.INIT=16'h8000;
  LUT4 n7_s2 (
    .F(n7_5),
    .I0(w_slot_address_6),
    .I1(w_slot_address_5),
    .I2(w_slot_address_4),
    .I3(w_r800_performance_start_9) 
);
defparam n7_s2.INIT=16'h0004;
  LUT4 n7_s3 (
    .F(n7_7),
    .I0(n7_4),
    .I1(w_bus_write_5),
    .I2(ff_bus_rdata_en_6),
    .I3(n233_8) 
);
defparam n7_s3.INIT=16'h8808;
  DFFRE ff_r800_led_s0 (
    .Q(w_r800_led),
    .D(w_slot_d[0]),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(n7_7) 
);
  DFFRE ff_rdata_0_s0 (
    .Q(w_device_pause_led_rdata[0]),
    .D(w_msx_pause),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(n18_4) 
);
  DFFRE ff_rdata_en_s0 (
    .Q(w_device_pause_led_rdata_en),
    .D(n18_4),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(VCC) 
);
defparam ff_rdata_en_s0.INIT=1'b0;
  INV n11_s2 (
    .O(n11_5),
    .I(ff_pause_led_reset_n) 
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* pause_led */
