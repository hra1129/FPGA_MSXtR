module r800_cache_ram (
  clk42m,
  n506_3,
  w_ram_write,
  ff_address,
  w_ram_write_data,
  \w_lookup_line[0] 
)
;
input clk42m;
input n506_3;
input w_ram_write;
input [20:3] ff_address;
input [63:0] w_ram_write_data;
output [73:0] \w_lookup_line[0] ;
wire [31:10] DO;
wire VCC;
wire GND;
  SP memory_memory_0_0_s (
    .DO(\w_lookup_line[0] [31:0]),
    .CLK(clk42m),
    .CE(n506_3),
    .OCE(GND),
    .RESET(GND),
    .WRE(w_ram_write),
    .AD({GND,ff_address[10:3],GND,VCC,VCC,VCC,VCC}),
    .DI(w_ram_write_data[31:0]),
    .BLKSEL({GND,GND,GND}) 
);
