    .F(w_we),
    .I0(w_ram_cs_14),
    .I1(n110_7) 
);
defparam w_we_s1.INIT=4'h4;
  LUT2 w_re_s1 (
    .F(w_re),
    .I0(w_ram_cs_14),
    .I1(n75_10) 
);
defparam w_re_s1.INIT=4'h4;
  LUT3 w_ram_cs_s4 (
    .F(w_ram_cs_10),
    .I0(w_r800_bus_address[12]),
    .I1(w_pico_bus_address[12]),
    .I2(w_cpu_sel[1]) 
);
defparam w_ram_cs_s4.INIT=8'hCA;
  LUT4 w_ram_cs_s5 (
    .F(w_ram_cs),
    .I0(w_device_bootrom_cs_3),
    .I1(w_device_bootrom_cs_4),
    .I2(w_bootrom_en),
    .I3(w_ram_cs_14) 
);
defparam w_ram_cs_s5.INIT=16'h0020;
  LUT4 n34_s1 (
    .F(n34_5),
    .I0(ff_bus_rdata_en_5),
    .I1(w_device_bootrom_cs_3),
    .I2(w_device_bootrom_cs_4),
    .I3(w_bootrom_en) 
);
defparam n34_s1.INIT=16'h0400;
  LUT4 w_ram_cs_s6 (
    .F(w_ram_cs_14),
    .I0(w_z80_bus_address[12]),
    .I1(w_ram_cs_10),
    .I2(w_cpu_sel[0]),
    .I3(w_cpu_sel[1]) 
);
defparam w_ram_cs_s6.INIT=16'h3335;
  DFFRE ff_q_en_s0 (
    .Q(w_device_bootrom_rdata_en),
    .D(n34_5),
    .CLK(clk42m),
    .RESET(w_bus_write),
    .CE(VCC) 
);
defparam ff_q_en_s0.INIT=1'b0;
  DFFRE ff_is_ram_s0 (
    .Q(ff_is_ram),
    .D(w_device_bootrom_cs),
    .CLK(clk42m),
    .RESET(w_ram_cs_14),
    .CE(VCC) 
);
defparam ff_is_ram_s0.INIT=1'b0;
