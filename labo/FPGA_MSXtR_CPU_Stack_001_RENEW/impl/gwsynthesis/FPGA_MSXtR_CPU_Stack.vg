module r800_cache_ram_3 (
  clk42m,
  n501_3,
  w_ram_write,
  ff_address,
  w_ram_write_data,
  \w_lookup_line[0] 
)
;
input clk42m;
input n501_3;
input w_ram_write;
input [20:3] ff_address;
input [63:0] w_ram_write_data;
output [73:0] \w_lookup_line[0] ;
wire [31:10] DO;
wire VCC;
wire GND;
  SP memory_memory_0_0_s (
    .DO(\w_lookup_line[0] [31:0]),
    .CLK(clk42m),
    .CE(n501_3),
    .OCE(GND),
    .RESET(GND),
    .WRE(w_ram_write),
    .AD({GND,ff_address[10:3],GND,VCC,VCC,VCC,VCC}),
    .DI(w_ram_write_data[31:0]),
    .BLKSEL({GND,GND,GND}) 
);
defparam memory_memory_0_0_s.BIT_WIDTH=32;
defparam memory_memory_0_0_s.BLK_SEL=3'b000;
defparam memory_memory_0_0_s.READ_MODE=1'b0;
defparam memory_memory_0_0_s.RESET_MODE="SYNC";
defparam memory_memory_0_0_s.WRITE_MODE=2'b00;
  SP memory_memory_0_1_s (
    .DO(\w_lookup_line[0] [63:32]),
    .CLK(clk42m),
    .CE(n501_3),
    .OCE(GND),
    .RESET(GND),
    .WRE(w_ram_write),
    .AD({GND,ff_address[10:3],GND,VCC,VCC,VCC,VCC}),
    .DI(w_ram_write_data[63:32]),
    .BLKSEL({GND,GND,GND}) 
);
defparam memory_memory_0_1_s.BIT_WIDTH=32;
defparam memory_memory_0_1_s.BLK_SEL=3'b000;
defparam memory_memory_0_1_s.READ_MODE=1'b0;
defparam memory_memory_0_1_s.RESET_MODE="SYNC";
defparam memory_memory_0_1_s.WRITE_MODE=2'b00;
  SP memory_memory_0_2_s (
    .DO({DO[31:10],\w_lookup_line[0] [73:64]}),
    .CLK(clk42m),
    .CE(n501_3),
    .OCE(GND),
    .RESET(GND),
    .WRE(w_ram_write),
    .AD({GND,ff_address[10:3],GND,VCC,VCC,VCC,VCC}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,ff_address[20:11]}),
    .BLKSEL({GND,GND,GND}) 
);
defparam memory_memory_0_2_s.BIT_WIDTH=32;
defparam memory_memory_0_2_s.BLK_SEL=3'b000;
defparam memory_memory_0_2_s.READ_MODE=1'b0;
defparam memory_memory_0_2_s.RESET_MODE="SYNC";
defparam memory_memory_0_2_s.WRITE_MODE=2'b00;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* r800_cache_ram_3 */
