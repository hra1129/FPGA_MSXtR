output w_ram_cs_10;
output [7:0] w_ram_q;
output [7:0] w_rom_q;
wire n34_3;
wire w_ram_cs;
wire w_re;
wire w_we;
wire n24_6;
wire VCC;
wire GND;
  LUT2 n34_s0 (
    .F(n34_3),
    .I0(ff_bus_rdata_en_5),
    .I1(w_device_bootrom_cs) 
);
defparam n34_s0.INIT=4'h4;
  LUT3 w_ram_cs_s2 (
    .F(w_ram_cs_7),
    .I0(w_ram_cs_10),
    .I1(w_pico_bus_address[12]),
    .I2(w_cpu_sel[1]) 
);
defparam w_ram_cs_s2.INIT=8'h3A;
  LUT3 w_ram_cs_s4 (
    .F(w_ram_cs_10),
    .I0(w_z80_bus_address[12]),
    .I1(w_r800_bus_address[12]),
    .I2(w_cpu_sel[0]) 
);
defparam w_ram_cs_s4.INIT=8'h35;
  LUT4 w_ram_cs_s5 (
    .F(w_ram_cs),
    .I0(w_ram_cs_10),
    .I1(w_pico_bus_address[12]),
    .I2(w_cpu_sel[1]),
    .I3(w_device_bootrom_cs) 
);
defparam w_ram_cs_s5.INIT=16'hC500;
  LUT4 w_re_s2 (
    .F(w_re),
    .I0(w_ram_cs_10),
    .I1(w_pico_bus_address[12]),
    .I2(w_cpu_sel[1]),
    .I3(n75_10) 
);
defparam w_re_s2.INIT=16'hC500;
  LUT4 w_we_s2 (
    .F(w_we),
    .I0(w_ram_cs_10),
    .I1(w_pico_bus_address[12]),
    .I2(w_cpu_sel[1]),
    .I3(n242_10) 
);
defparam w_we_s2.INIT=16'hC500;
  DFFRE ff_q_en_s0 (
    .Q(w_device_bootrom_rdata_en),
    .D(n34_3),
    .CLK(clk42m),
    .RESET(w_bus_write),
    .CE(VCC) 
);
defparam ff_q_en_s0.INIT=1'b0;
  DFFRE ff_is_ram_s0 (
    .Q(ff_is_ram),
    .D(w_device_bootrom_cs),
    .CLK(clk42m),
    .RESET(w_ram_cs_7),
    .CE(VCC) 
);
defparam ff_is_ram_s0.INIT=1'b0;
  INV n24_s2 (
    .O(n24_6),
    .I(ff_bootrom_reset_n) 
);
  rom u_rom (
    .clk42m(clk42m),
    .w_ram_cs_7(w_ram_cs_7),
    .ff_bootrom_reset_n(ff_bootrom_reset_n),
    .w_device_bootrom_cs(w_device_bootrom_cs),
    .n75_10(n75_10),
    .w_slot_address(w_slot_address[11:0]),
    .w_rom_q(w_rom_q[7:0])
);
  ip_ram u_ram (
    .clk42m(clk42m),
    .w_ram_cs(w_ram_cs),
    .w_re(w_re),
    .n24_6(n24_6),
    .w_we(w_we),
    .w_slot_address(w_slot_address[10:0]),
    .w_slot_d(w_slot_d[7:0]),
    .w_ram_q(w_ram_q[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* bootrom */
