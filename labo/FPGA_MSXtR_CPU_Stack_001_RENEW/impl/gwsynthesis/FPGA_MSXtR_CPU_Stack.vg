input [11:0] w_slot_address;
input [7:0] w_device_wdata;
output w_device_bootrom_rdata_en;
output ff_is_ram;
output w_ram_cs_10;
output w_ram_cs_14;
output [7:0] w_ram_q;
output [7:0] w_rom_q;
