module pause_led (
  clk42m,
  w_msx_pause,
  n110_7,
  n75_12,
  n75_7,
  slot_data_dir_d_4,
  ff_pause_led_reset_n,
  w_slot_d,
  w_slot_address_0,
  w_slot_address_1,
  w_slot_address_2,
  w_slot_address_5,
  w_slot_address_6,
  w_r800_led,
  w_device_pause_led_rdata_en,
  n7_4,
  w_device_pause_led_rdata
)
;
input clk42m;
input w_msx_pause;
input n110_7;
input n75_12;
input n75_7;
input slot_data_dir_d_4;
input ff_pause_led_reset_n;
input [0:0] w_slot_d;
input w_slot_address_0;
input w_slot_address_1;
input w_slot_address_2;
input w_slot_address_5;
input w_slot_address_6;
output w_r800_led;
output w_device_pause_led_rdata_en;
output n7_4;
output [0:0] w_device_pause_led_rdata;
wire n7_3;
wire n18_4;
wire n7_5;
wire n11_5;
wire VCC;
wire GND;
  LUT2 n7_s0 (
    .F(n7_3),
    .I0(n7_4),
    .I1(n110_7) 
);
defparam n7_s0.INIT=4'h8;
  LUT2 n18_s1 (
    .F(n18_4),
    .I0(n7_4),
    .I1(n75_12) 
);
defparam n18_s1.INIT=4'h8;
  LUT4 n7_s1 (
    .F(n7_4),
    .I0(n7_5),
    .I1(w_slot_address_0),
    .I2(w_slot_address_2),
    .I3(n75_7) 
);
defparam n7_s1.INIT=16'h8000;
  LUT4 n7_s2 (
    .F(n7_5),
    .I0(w_slot_address_6),
    .I1(w_slot_address_1),
    .I2(w_slot_address_5),
    .I3(slot_data_dir_d_4) 
);
defparam n7_s2.INIT=16'h0040;
  DFFRE ff_r800_led_s0 (
    .Q(w_r800_led),
    .D(w_slot_d[0]),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(n7_3) 
);
  DFFRE ff_rdata_0_s0 (
    .Q(w_device_pause_led_rdata[0]),
    .D(w_msx_pause),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(n18_4) 
);
  DFFRE ff_rdata_en_s0 (
    .Q(w_device_pause_led_rdata_en),
    .D(n18_4),
    .CLK(clk42m),
    .RESET(n11_5),
    .CE(VCC) 
);
defparam ff_rdata_en_s0.INIT=1'b0;
  INV n11_s2 (
    .O(n11_5),
    .I(ff_pause_led_reset_n) 
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* pause_led */
